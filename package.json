{
  "name": "shed-designer-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A standalone 3D shed designer: every real shed part is its own module, a new company is one settings file.",
  "scripts": {
    "serve": "npx http-server -p 8282 -c-1 .",
    "check": "node tools/check-all.mjs",
    "build": "node tools/build-site.mjs",
    "build:client": "node tools/build-site.mjs --client"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@netlify/functions": "^6.0.2",
    "@netlify/identity": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
